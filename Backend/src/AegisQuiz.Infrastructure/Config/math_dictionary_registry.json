  "structuralSimplificationRules": [
    {
      "id": "RULE_SIMPLE_FRACTION",
      "name": "Phân số đơn giản 1 gạch ngang",
      "priority": 100,
      "enabled": true,
      "anchor": {
        "type": "GEOMETRIC_LINE",
        "orientation": "HORIZONTAL",
        "count": 1,
        "maxSlope": 0.08
      },
      "slots": [
        {
          "name": "numerator",
          "relativePosition": "ABOVE_ANCHOR",
          "maxDistanceYRatio": 1.5,
          "paddingX": 40,
          "maxTokens": 8,
          "allowedPattern": "^[0-9a-zA-Z\\+\\-\\.\\s\\(\\)\\\\]+$",
          "optional": false
        },
        {
          "name": "denominator",
          "relativePosition": "BELOW_ANCHOR",
          "maxDistanceYRatio": 1.5,
          "paddingX": 40,
          "maxTokens": 8,
          "allowedPattern": "^[0-9a-zA-Z\\+\\-\\.\\s\\(\\)\\\\]+$",
          "optional": false
        }
      ],
      "constraints": {
        "disallowPolygons": true,
        "maxTotalChars": 30,
        "maxLines": 1
      },
      "template": "\\frac{{{numerator}}}{{{denominator}}}"
    },
    {
      "id": "RULE_RADICAL_OVERLINE",
      "name": "Căn thức đơn giản có gạch nóc",
      "priority": 90,
      "enabled": true,
      "anchor": {
        "type": "COMPOUND",
        "symbol": "\\sqrt",
        "attachedLine": "TOP_OVERLINE"
      },
      "slots": [
        {
          "name": "radicand",
          "relativePosition": "UNDER_OVERLINE",
          "maxDistanceYRatio": 1.5,
          "paddingX": 15,
          "maxTokens": 10,
          "allowedPattern": "^[0-9a-zA-Z\\+\\-\\.\\s\\(\\)]+$",
          "optional": false
        },
        {
          "name": "degree",
          "relativePosition": "TOP_LEFT_CORNER",
          "maxTokens": 2,
          "allowedPattern": "^[0-9n]$",
          "optional": true
        }
      ],
      "constraints": {
        "disallowPolygons": true,
        "maxTotalChars": 30,
        "maxLines": 1
      },
      "template": "\\sqrt{{{radicand}}}"
    },
    {
      "id": "RULE_SYSTEM_OF_EQUATIONS",
      "name": "Hệ hai phương trình dấu ngoặc nhọn",
      "priority": 80,
      "enabled": true,
      "anchor": {
        "type": "DELIMITER_SYMBOL",
        "symbol": "{",
        "minHeightRatio": 1.5
      },
      "slots": [
        {
          "name": "row1",
          "relativePosition": "RIGHT_UPPER",
          "maxTokens": 15,
          "allowedPattern": "^[0-9a-zA-Z\\+\\-\\=\\.\\s]+$",
          "optional": false
        },
        {
          "name": "row2",
          "relativePosition": "RIGHT_LOWER",
          "maxTokens": 15,
          "allowedPattern": "^[0-9a-zA-Z\\+\\-\\=\\.\\s]+$",
          "optional": false
        }
      ],
      "constraints": {
        "disallowPolygons": true,
        "maxTotalChars": 50,
        "maxLines": 0
      },
      "template": "\\begin{cases} {{row1}} \\\\ {{row2}} \\end{cases}"
    },
    {
      "id": "RULE_LIMIT_EXPRESSION",
      "name": "Biểu thức giới hạn lim",
      "priority": 85,
      "enabled": true,
      "anchor": {
        "type": "TEXT_ANCHOR",
        "symbol": "\\lim"
      },
      "slots": [
        {
          "name": "subscript",
          "relativePosition": "DIRECTLY_BELOW",
          "maxDistanceYRatio": 1.2,
          "paddingX": 15,
          "maxTokens": 8,
          "allowedPattern": "^[a-zA-Z0-9\\\\to\\\\infty\\-\\+\\s]+$",
          "optional": false
        },
        {
          "name": "argument",
          "relativePosition": "RIGHT_ADJACENT",
          "maxTokens": 20,
          "optional": false
        }
      ],
      "constraints": {
        "disallowPolygons": true,
        "maxTotalChars": 40,
        "maxLines": 0
      },
      "template": "\\lim_{{{subscript}}} {{argument}}"
    },
    {
      "id": "RULE_VECTOR_OVERLINE",
      "name": "Mũi tên vector hình học",
      "priority": 95,
      "enabled": true,
      "anchor": {
        "type": "VECTOR_OVERLINE"
      },
      "slots": [
        {
          "name": "base",
          "relativePosition": "BELOW_ANCHOR",
          "maxTokens": 4,
          "allowedPattern": "^[a-zA-Z\\']+$",
          "optional": false
        }
      ],
      "constraints": {
        "disallowPolygons": true,
        "maxTotalChars": 20,
        "maxLines": 0
      },
      "template": "\\vec{{{base}}}"
    }
