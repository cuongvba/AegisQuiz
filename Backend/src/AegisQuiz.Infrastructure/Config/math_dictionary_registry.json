  "inlineNormalizations": [
    {
      "pattern": "(?<=[A-Z])[’´`′]",
      "replacement": "'",
      "desc": "Chuẩn hóa dấu phẩy trên cho đỉnh hình học A', B', C', D'"
    },
    {
      "pattern": "([A-Z]{2})\\u20D7",
      "replacement": "$\\overrightarrow{$1}$",
      "desc": "Vector 2 điểm OpenXML combining accent"
    },
    {
      "pattern": "([a-zA-Z])\\u20D7",
      "replacement": "$\\vec{$1}$",
      "desc": "Vector 1 chữ cái combining accent"
    },
    {
      "pattern": "([A-Z])\\^2",
      "replacement": "$1^2",
      "desc": "Chuẩn hóa số mũ"
    },
    {
      "pattern": "(\\d+)\\^0(?![\\d])",
      "replacement": "$1^{\\circ}",
      "desc": "Chuẩn hóa độ góc số học (VD: 30^0 -> 30^\\circ)"
    },
    {
      "pattern": "\\b(tam\\s*giác|tg)\\s+([A-Z]{3})\\b",
      "replacement": "$\\Delta $2$",
      "desc": "Chuẩn hóa ký hiệu tam giác hình học"
    },
    {
      "pattern": "\\b(góc)\\s+([A-Z]{3}|[a-z]{1,2}[A-Z][a-z]{1,2})\\b",
      "replacement": "$\\widehat{$2}$",
      "desc": "Chuẩn hóa góc hình học THCS"
    },
    {
      "pattern": "√\\s*(\\d+|[a-zA-Z])",
      "replacement": "$\\sqrt{$1}$",
      "desc": "Chuẩn hóa ký hiệu căn bậc hai (VD: √3 -> $\\sqrt{3}$)"
    },
    {
      "pattern": "√\\s*\\(([^\\)]+)\\)",
      "replacement": "$\\sqrt{$1}$",
      "desc": "Chuẩn hóa ký hiệu căn bậc hai có ngoặc (VD: √(x+1) -> $\\sqrt{x+1}$)"
    },
    {
      "pattern": "([A-Z]{3,4})\\s*\\\\cdot\\s*([A-Z])",
      "replacement": "$1.$2",
      "desc": "Chuẩn hóa dấu chấm hình lập phương/lăng trụ ABCD.A'B'C'D'"
    }
  ],
