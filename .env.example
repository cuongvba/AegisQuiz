# ============================================================
# AegisQuiz — Environment Variables Template
# [CG2: Cảm biến Đe dọa] KHÔNG commit file .env lên Git!
# Sao chép: cp .env.example .env  rồi điền giá trị thật
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
POSTGRES_DB=aegisquiz
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS

# ── Redis ────────────────────────────────────────────────────
# Để trống nếu không dùng password (local dev)
REDIS_PASSWORD=

# ── Backend Application ──────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# JWT Secret — tối thiểu 32 ký tự, dùng: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_VIA_OPENSSL_RAND_HEX_32

# Google Gemini API Key — lấy từ: https://aistudio.google.com/
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY

# Webhook HMAC Secret — dùng cùng key với Casso/SePay dashboard
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET_KEY

# ── Frontend & Gateway ──────────────────────────────────────
PORT=80
VITE_API_URL=
VITE_AUTH_HUB_URL=https://dehoc.vn

# ── IRT Adaptive Testing Service ────────────────────────────
IRT_SERVICE_URL=http://irt-service:8001

# ── Optional Production Controls ───────────────────────────
# Đặt true nếu muốn kiểm tra Swagger UI trực tiếp trên Production: /swagger
ENABLE_SWAGGER=false

# ── Keycloak IdP (CG6: Định danh Tuyệt đối) ─────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# ── GCP / Cloud (CG4: Kiến tạo Đám mây) ─────────────────────
# Chỉ cần khi deploy lên GCP Cloud Run
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=asia-southeast1

